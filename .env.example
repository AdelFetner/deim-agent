# Copy to .env (chmod 600) and fill in. .env is git-ignored. No spaces, quotes or '$' in values.

# OpenCode Go API key (https://opencode.ai/console).
OPENCODE_GO_API_KEY=

# Model A (default). Model B is switched live via an MR comment (see RUNBOOK).
PR_AGENT_MODEL=openai/glm-5.3

# GitLab root password; bootstrap.sh sets it via the API. Must be strong (>= 12 chars, not common),
# e.g. output of: openssl rand -base64 18 | tr -d '/+='
GITLAB_ROOT_PASSWORD=

# Filled automatically by scripts/bootstrap.sh — leave empty.
PR_AGENT_GITLAB_TOKEN=
PR_AGENT_WEBHOOK_SECRET=
